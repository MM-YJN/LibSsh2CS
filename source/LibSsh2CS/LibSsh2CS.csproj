<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The Pageant interop is generated by CsWin32 and uses pointers
         (PCWSTR, COPYDATASTRUCT and the mapped view), so the project has to
         allow unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Preserve the library-specific analyzer suppressions from the source project. -->
    <NoWarn>$(NoWarn);CA1008;CA1021;CA1045;CA1055;CA1308;CA1502;CA1506</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LibSsh2CS.UnitTests" />
    <InternalsVisibleTo Include="LibSsh2CS.IntegrationTests" />
    <InternalsVisibleTo Include="LibSsh2CS.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates the Windows interop the Pageant agent backend needs from the
         Win32 metadata, so the library carries no hand-written P/Invokes.
         NativeMethods.txt lists the requested APIs. The repository configures
         the generator to run as a build task, and disables runtime marshalling,
         in Directory.Build.props. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
  </ItemGroup>

</Project>
