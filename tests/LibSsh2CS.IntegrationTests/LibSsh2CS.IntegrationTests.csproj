<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarnForTestProjects);CA1063;CA1816</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <!-- Generates the Win32 lookups the Windows-only fixtures need. NativeMethods.json
         gives the generated class a name of its own, because the referenced library
         generates the same Win32 types and grants this project InternalsVisibleTo. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
    <PackageReference Include="Testcontainers" Version="4.14.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\LibSsh2CS\LibSsh2CS.csproj" />
    <!--
      Build dependency only: PageantTestHost is an independent fixture process
      that deliberately does not reference the library, so it is staged next to
      the test output by the StagePageantTestHost target below instead of being
      referenced as an assembly. Private=false also prevents the SDK from copying
      the apphost to the test output root, where its Linux filename would collide
      with the staging directory.
    -->
    <ProjectReference Include="..\LibSsh2CS.PageantTestHost\LibSsh2CS.PageantTestHost.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\**\*" />
  </ItemGroup>

  <!--
    Copies the helper's app bundle — host executable, assembly, dependency and
    runtime-configuration files — into its own subdirectory of the test output.
    PageantIpcTests then launches a stable path relative to the test assembly,
    so testing this project alone builds the helper and runs without a
    solution-wide build first.
  -->
  <Target Name="StagePageantTestHost" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\LibSsh2CS.PageantTestHost\LibSsh2CS.PageantTestHost.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_PageantTestHostTargetPath" />
    </MSBuild>

    <PropertyGroup>
      <_PageantTestHostBuildOutput>@(_PageantTestHostTargetPath->'%(RootDir)%(Directory)')</_PageantTestHostBuildOutput>
      <_PageantTestHostStagingDirectory>$(OutDir)PageantTestHost\</_PageantTestHostStagingDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_PageantTestHostArtifact Include="$(_PageantTestHostBuildOutput)PageantTestHost.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_PageantTestHostArtifact)"
          DestinationFolder="$(_PageantTestHostStagingDirectory)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
